       (lambda (key . args)
         (display (format #f "error loading env.scm: ~a: ~a" key args))))

;; Store the thread object belonging to the byggsteg queue worker
(define worker-thread
  #f)

;; Procedure to start the byggsteg queue worker to process jobs that haven't completed yet
;; this is preferrably done in a different thread
;;
;; The worker needs no request context: the repositories take their connection
;; from `(byggsteg sqlite util)', which owns the process-wide SQLite handle
;; rather than borrowing Artanis' request connection pool.  That is what the
;; mock request and its dummy route used to stand in for.
(define (start-worker)
  (set! worker-thread
        (call-with-new-thread (lambda ()
                                (sleep 3) ;delay worker start
                                (display (format #f "\n~a...\n"
                                                 (gettext
                                                  "initializing byggsteg queue worker")))

                                (use-modules (byggsteg job pipeline)
                                             (byggsteg domain job)
                                             (byggsteg domain log)
                                             (byggsteg sqlite job)
                                             (byggsteg sqlite log))
                                (let ((job-repo (make-sqlite-job-repository))
                                      (log-repo (make-sqlite-log-repository)))
                                  (while #t
                                         (run-infallible-pipeline #:job-repo
                                                                  job-repo
                                                                  #:log-repo
                                                                  log-repo)))))))

;; Add hook on before running the Artanis application to start the queue worker
(run-before-run! start-worker)

;; Procedure to stop the byggsteg queue worker
(define (cancel-worker)
  (display "\nterminating byggsteg queue worker\n")
  (cancel-thread worker-thread))

;; Add a hook on SIGINT to stop the queue worker
(run-when-sigint! cancel-worker)
