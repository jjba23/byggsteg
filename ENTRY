;; This is the Artanis ENTRY file, don't remove it!

(use-modules (artanis artanis)
             ;; Put modules you want to be imported here
             ;; only for this file, not controllers/views
             (ice-9 threads)
             (artanis utils)
             (ice-9 i18n)
             (artanis irregex))
;; Put whatever you want to be called before server initilization here

(init-server #:statics '(png gif
                             jpg
                             jpeg
                             ico
                             html
                             js
                             json
                             csv
                             xml
                             css
                             woff
                             woff2
                             ttf))
(add-to-load-path (string-append (current-toplevel) "/lib"))

;; Put whatever you want to be called before server running here

;; Specify the directory where the MO file is located
(bindtextdomain "translate" "./sys/i18n/locale")
(bind-textdomain-codeset "translate" "UTF-8")
;; Specify the domain of the MO file since you may have multiple MO files
(textdomain "translate")
;; Set base locale for gettext at startup
(setlocale LC_MESSAGES "en_US.UTF-8")

(catch #t
       (lambda ()
         (display "\nloading env.scm\n")
         (load "env.scm"))
       (lambda (key . args)
         (display (format #f "error loading env.scm: ~a: ~a" key args))))

;; Store the thread object belonging to the byggsteg queue worker
(define worker-thread
  #f)

;; Procedure to start the byggsteg queue worker to process jobs that haven't completed yet
;; this is preferrably done in a different thread
(define (start-worker)
  (let* ((t (call-with-new-thread (lambda ()
                                    (sleep 3) ;delay worker start
                                    (display (format #f "\n~a...\n"
                                                     (gettext
                                                      "initializing byggsteg queue worker")))

                                    (use-modules (byggsteg job pipeline))
                                    (while #t
                                           (run-infallible-pipeline))))))
    (set! worker-thread t)))

;; define dummy route so that fake request-context can be used
(post "/dummy-pipeline-context"
      (lambda (rc)
        "dummy"))

;; Add hook on before running the Artanis application to start the queue worker
(run-before-run! start-worker)

;; Procedure to stop the byggsteg queue worker
(define (cancel-worker)
  (display "\nterminating byggsteg queue worker\n")
  (cancel-thread worker-thread))

;; Add a hook on SIGINT to stop the queue worker
(run-when-sigint! cancel-worker)
